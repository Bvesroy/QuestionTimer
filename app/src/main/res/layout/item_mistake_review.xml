<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvMistakeQuestionNum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:text="Q#14"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvMistakeSessionName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="JEE ADVANCED ROTATIONAL MOTION"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvMistakeDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="02:34.5"
            android:textColor="@color/accent_paused"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Badges Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvMistakeSubjectBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill_accent"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="PHYSICS"
            android:textColor="@color/accent_highlight"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/tvMistakeOutcomeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill_orange"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="INCORRECT"
            android:textColor="@color/accent_discard"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/tvMistakeTagBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill_unselected"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="SILLY MISTAKE"
            android:textColor="@color/accent_paused"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/tvMistakeConfidence"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="CONF: ★★★☆☆"
            android:textColor="@color/text_secondary"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Notes Text -->
    <TextView
        android:id="@+id/tvMistakeNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif"
        android:text="Sign convention reversed during integration of moment of inertia."
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <!-- Actions Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="10dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnToggleRevised"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill_accent"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:paddingHorizontal="12dp"
            android:text="MARK REVISED"
            android:textColor="@color/accent_running"
            android:textSize="9sp" />

        <Button
            android:id="@+id/btnEditMistakeTags"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_pill_unselected"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:paddingHorizontal="12dp"
            android:text="EDIT TAGS"
            android:textColor="@color/text_primary"
            android:textSize="9sp" />
    </LinearLayout>

</LinearLayout>
