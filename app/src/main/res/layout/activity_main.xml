<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amoled_black"
    android:fitsSystemWindows="false">

    <!-- Top Session Header Container (Clickable to rename) -->
    <LinearLayout
        android:id="@+id/topBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="42dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp">

        <!-- Exam Countdown Banner -->
        <TextView
            android:id="@+id/tvExamBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_pill"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:textColor="@color/accent_paused"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="JEE ADVANCED IN 142 DAYS • KEEP PUSHING"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/layoutSessionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tvSessionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.16"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_session_title"
                tools:text="JEE ADVANCED PHYSICS" />

            <ImageView
                android:id="@+id/ivEditTitle"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="8dp"
                android:alpha="0.6"
                android:contentDescription="@null"
                android:src="@drawable/ic_edit"
                android:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Subtle Target Display (Clickable to edit target) -->
        <TextView
            android:id="@+id/tvTarget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_target"
            tools:text="QUESTION 1 / 50" />

    </LinearLayout>

    <!-- Central Timer Readout & State Pill Container -->
    <LinearLayout
        android:id="@+id/centerContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTimerReadout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_timer_portrait"
            android:textStyle="bold"
            tools:text="00:00.0" />

        <!-- Status Cue Badge (e.g. TAP ANYWHERE TO START) -->
        <TextView
            android:id="@+id/tvStateBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_pill"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.14"
            android:text="@string/badge_ready"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_badge" />

        <!-- Live Outcome Performance Analytics KPI Display -->
        <TextView
            android:id="@+id/tvLiveAnalytics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="ACCURACY: 80% (4/5) • 4C 1W • EST: +15 PTS • AVG: 52s"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- Total Study Clock & Break Indicator (Positioned in corner or configured via settings) -->
    <TextView
        android:id="@+id/tvTotalStudyClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="96dp"
        android:background="@drawable/bg_pill"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="monospace"
        android:letterSpacing="0.08"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:text="STUDY: 00:00:00 • BREAK: 00:00"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Two-Zone Visual Feedback Overlays (Red for Upper/Wrong, Green for Lower/Right) -->
    <LinearLayout
        android:id="@+id/layoutZoneFeedback"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:elevation="8dp"
        android:focusable="false"
        android:orientation="vertical">

        <View
            android:id="@+id/viewUpperFeedback"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#00000000"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />

        <View
            android:id="@+id/viewLowerFeedback"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#00000000"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Transient Undo Notification Banner -->
    <LinearLayout
        android:id="@+id/layoutUndoBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomControlsContainer"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_dialog_card"
        android:elevation="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvUndoMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:text="Q1: SOLVED (01:23.4)"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnUndoAnswer"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_pill_accent"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.08"
            android:paddingHorizontal="12dp"
            android:text="UNDO"
            android:textColor="@color/accent_running"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Subtle Bottom Control Bar (4 Auto-Hiding Buttons) -->
    <LinearLayout
        android:id="@+id/bottomControlsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:elevation="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="42dp">

        <!-- 1. Discard / Reset Current Question -->
        <ImageButton
            android:id="@+id/btnDiscard"
            android:layout_width="@dimen/control_button_size"
            android:layout_height="@dimen/control_button_size"
            android:background="@drawable/bg_button_subtle"
            android:contentDescription="@string/desc_discard"
            android:src="@drawable/ic_discard"
            android:tint="@color/text_secondary" />

        <Space
            android:layout_width="22dp"
            android:layout_height="wrap_content" />

        <!-- 2. Manual Toggle (Play / Pause) -->
        <ImageButton
            android:id="@+id/btnToggle"
            android:layout_width="@dimen/control_button_size"
            android:layout_height="@dimen/control_button_size"
            android:background="@drawable/bg_button_subtle"
            android:contentDescription="@string/desc_toggle"
            android:src="@drawable/ic_play"
            android:tint="@color/text_primary" />

        <Space
            android:layout_width="22dp"
            android:layout_height="wrap_content" />

        <!-- 3. History & Stats Bottom Sheet Opener -->
        <ImageButton
            android:id="@+id/btnHistory"
            android:layout_width="@dimen/control_button_size"
            android:layout_height="@dimen/control_button_size"
            android:background="@drawable/bg_button_subtle"
            android:contentDescription="@string/desc_history"
            android:src="@drawable/ic_history"
            android:tint="@color/text_secondary" />

        <Space
            android:layout_width="22dp"
            android:layout_height="wrap_content" />

        <!-- 4. Settings Dialog Opener -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="@dimen/control_button_size"
            android:layout_height="@dimen/control_button_size"
            android:background="@drawable/bg_button_subtle"
            android:contentDescription="@string/desc_settings"
            android:src="@drawable/ic_settings"
            android:tint="@color/text_secondary" />

    </LinearLayout>

</RelativeLayout>
