<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="@dimen/drag_handle_width"
        android:layout_height="@dimen/drag_handle_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/sheet_drag_handle" />

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.14"
                android:text="SESSION COMPLETION NOTES"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.06"
                android:text="Reflect on your solving performance"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseNotes"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_close"
            android:tint="@color/text_secondary" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Session Name Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.1"
                android:text="SESSION TITLE"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etNoteSessionTitle"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_pill"
                android:inputType="textCapCharacters"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                tools:text="JEE ADVANCED PHYSICS" />

            <!-- Subject Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.1"
                android:text="SUBJECT / CATEGORY"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutSubjectPills"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/pillSubMath"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_pill_unselected"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        android:paddingHorizontal="12dp"
                        android:text="Mathematics"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/pillSubPhysics"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_pill_selected"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        android:paddingHorizontal="12dp"
                        android:text="Physics"
                        android:textColor="@color/accent_highlight"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/pillSubChem"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_pill_unselected"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        android:paddingHorizontal="12dp"
                        android:text="Chemistry"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/pillSubBio"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_pill_unselected"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        android:paddingHorizontal="12dp"
                        android:text="Biology"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/pillSubGeneral"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_pill_unselected"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        android:paddingHorizontal="12dp"
                        android:text="General"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/pillSubCustom"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_pill_unselected"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        android:paddingHorizontal="12dp"
                        android:text="+ Custom"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                </LinearLayout>
            </HorizontalScrollView>

            <EditText
                android:id="@+id/etCustomSubject"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill"
                android:hint="Enter custom subject..."
                android:inputType="textCapWords"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- General Notes -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.1"
                android:text="SESSION OBSERVATIONS &amp; CHAPTER"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etSessionNotes"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:background="@drawable/bg_dialog_card"
                android:gravity="top|start"
                android:hint="Chapter name, problem source, or general remarks..."
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="12sp" />

            <!-- What Went Well -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.1"
                android:text="WHAT WENT WELL"
                android:textColor="@color/accent_running"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etWhatWentWell"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/bg_dialog_card"
                android:gravity="top|start"
                android:hint="Strengths: quick recall, good elimination strategy..."
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="12sp" />

            <!-- Needs Improvement -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.1"
                android:text="AREAS FOR IMPROVEMENT"
                android:textColor="@color/accent_paused"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etNeedsImprovement"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/bg_dialog_card"
                android:gravity="top|start"
                android:hint="Mistakes: calculation slip on Q5, formula confusion..."
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="12sp" />

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSkipNotes"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_subtle"
                    android:letterSpacing="0.1"
                    android:text="SKIP"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnSaveNotes"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="2"
                    android:background="@drawable/bg_button_tonal"
                    android:letterSpacing="0.1"
                    android:text="SAVE NOTES"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
