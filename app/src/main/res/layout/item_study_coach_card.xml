<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header: Title and Priority Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCoachCardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            tools:text="Pacing Optimization" />

        <TextView
            android:id="@+id/tvCoachPriorityBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_accent"
            android:fontFamily="sans-serif-bold"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="HIGH"
            android:textColor="@color/accent_running"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Meta pills: Timeframe & Sample size -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCoachTimeframe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="Last 7 Days"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvCoachSampleSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="42 Qs analyzed"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Observation -->
    <TextView
        android:id="@+id/tvCoachObservation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        tools:text="Average solve pace is 172s/Q (exceeding standard JEE target of 144s)." />

    <!-- Actionable Recommendation -->
    <TextView
        android:id="@+id/tvCoachRecommendation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pill_unselected"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingExtra="2dp"
        android:padding="10dp"
        android:textColor="@color/accent_highlight"
        android:textSize="12sp"
        tools:text="💡 Adopt 2-pass strategy: clear single-concept problems first (&lt;90s) and defer complex calculations." />

    <!-- Rationale -->
    <TextView
        android:id="@+id/tvCoachRationale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="italic"
        tools:text="JEE Main scoring prioritizes question volume over proof difficulty." />

    <!-- Feedback & Dismiss Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCoachUseful"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="✓ USEFUL"
            android:textColor="@color/accent_running"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/btnCoachNotUseful"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="✗ NOT USEFUL"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnCoachDismiss"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="DISMISS"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
