<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_dialog_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvItemSessionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            tools:text="JEE ADVANCED MATHEMATICS" />

        <TextView
            android:id="@+id/tvItemSessionSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            tools:text="34 Solved • Created 25 Oct" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvItemActiveTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_accent"
        android:letterSpacing="0.08"
        android:text="ACTIVE"
        android:textColor="@color/accent_running"
        android:textSize="10sp"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
